# SLOP-LORD — Environment Variables
# Copy this to .env and fill in your values.
# This file is committed. .env is NOT committed.
#
# Most settings live in config/runtime.yaml.
# Set env vars here ONLY to override runtime.yaml without editing it.

# --- Required ---

# Postgres password (used by docker-compose and the agent)
DB_PASSWORD=changeme

# --- LLM Inference Backends ---
# Three roles: text (generation/reasoning), vision (image analysis), verify (edit checking).
# Defaults in config/runtime.yaml point to the DGX Spark setup.
# Override individual roles here without touching the YAML.

# Text backend — brief generation, picker, scoring
# INFERENCE_TEXT_URL=http://10.0.1.8:1234/v1
# INFERENCE_TEXT_MODEL=eclipsed-phoenix-26b-a4b-heretic

# Vision backend — thumbnail analysis fed into briefs
# INFERENCE_VISION_URL=http://10.0.1.3:8888/v1
# INFERENCE_VISION_MODEL=qwen3.8-27b-sglang

# Verify backend — Qwen-edit pass/fail judge (can be same as vision)
# INFERENCE_VERIFY_URL=http://10.0.1.3:8888/v1
# INFERENCE_VERIFY_MODEL=qwen3.8-27b-sglang

# Legacy aliases — also accepted, mirror into inference.text automatically
# LM_STUDIO_BASE_URL=http://10.0.1.8:1234/v1
# LM_STUDIO_MODEL=eclipsed-phoenix-26b-a4b-heretic

# --- ComfyUI (Qwen-Image-Edit + MiniMax H3) ---
# COMFYUI_HOST=10.0.1.3
# COMFYUI_PORT=8188

# --- Browser / Chrome CDP ---
# BROWSER_CDP_PORT=9222
# BROWSER_CDP_HOST=localhost
# CHROME_PROFILE_DIR=~/.slop-lord/chrome-profile

# --- Scanner tuning ---
# SCANNER_INTERVAL_MINUTES=60
# TSS_THRESHOLD=0.65
# DEDUP_WINDOW_HOURS=48

# --- Storage ---
# MINIMAX_OUTPUT_DIR=./generated
# DOWNLOADS_DIR=./downloads

# --- Stagehand (optional — only needed if using AI browser DOM fallback) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# STAGEHAND_MODEL=gpt-4o-mini
